<!-- 
REQUIREMENTS_STATUS values
  - draft - requirements generated by model
  - approved - requirements approved by user
-->
<Requirements REQUIREMENTS_STATUS="[REQUIRED]">

  <ProjectName>$PROJECT_NAME</ProjectName>

  <Actors>
    <!--
    ACTOR_ROLE values:
      - primary - 
      - secondary -
      - system - 
    Use ACTOR_1 format. Monotony grow id.
    -->
    <ACTOR_{ID} ACTOR_ROLE="[REQUIRED]">
      <Description><!-- Who is this and what do they want? --></Description>
    </ACTOR_{ID}>
  </Actors>

  <UseCases>
    <!--
     USECASE_PRIORITY values:
     - high 
     - medium 
     - low
    -->
    <!-- Use USECASE_1 format. Monotony grow id.-->
    <USECASE_{ID} USECASE_PRIORITY="[REQUIRED]">
      <Actor TARGET="ACTOR_{ID}"/>
      <Action><!-- What does the actor do? --></Action>
      <Goal><!-- What is the business value / outcome? --></Goal>
      <AcceptanceCriteria>
        <!-- Use AC_1 format. Monotony grow id. -->
        <AC_{ID}><!-- How do we verify it works? --></AC_{ID}>
      </AcceptanceCriteria>
    </USECASE_{ID}>
  </UseCases>

  <NonGoals>
    <!-- Define what we are NOT building — prevents over-engineering -->
    <!-- Use NOGOAL_1 format -->
    <NOGOAL_{ID}>
      <!-- e.g., No public API for external developers in v1 -->
    </NOGOAL_{ID}>
  </NonGoals>

  <Constraints>
    <!-- Application level requirements constraints -->
    <!-- Use REQ_CONSTRAINT_1 format. Monotony grow id. -->
    <REQ_CONSTRAINT_{ID}>
      <Description><!-- e.g., All user data must be stored in the EU region --></Description>
    </REQ_CONSTRAINT_{ID}>
  </Constraints>

  <Risks>
    <!-- Known ambiguity or failure-prone areas.-->
    <!-- Use REQ_RISK_1 format -->
    <REQ_RISK_{ID}>
        <Description></Description>
        <Affects TARGET="USECASE_3, USECASE_5"/>
        <Mitigation><!-- How is it possible to mitigate this problem --></Mitigation>
    </REQ_RISK_{ID}>
  </Risks>

  <OpenQuestions>
    <!-- Use QUESTION_1 format. Monotony grow id. -->
    <!-- QUESTION_STATUS values:
      - open
      - answered
    -->
    <QUESTION_{ID} QUESTION_STATUS="[REQUIRED]" BLOCKS="[REQUIRED]">
      <Description><!-- What is unclear and what does it block? --></Description>
      <Resolution>
        <!-- Once question is 'answered' put resolution -->
      </Resolution>
    </QUESTION_{ID}>
  </OpenQuestions>

</Requirements>